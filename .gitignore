.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# خروجی‌های تست
/coverage
/.nyc_output

# فایل‌های مربوط به پکیج‌منیجرها
.npm
.eslintcache
.stylelintcache

# فایل‌های موقت سیستم
.cache/
.parcel-cache/
